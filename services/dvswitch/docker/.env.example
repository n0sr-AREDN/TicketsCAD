# TicketsCAD DMR bridge (Docker) — copy to .env and fill in.
#   cp .env.example .env && docker compose up -d --build
# Keep .env out of git: it holds your master passphrase and CAD bearer token.

# ── Your amateur radio identity ────────────────────────────────────────────
# Must match your radioid.net registration. You are the licensed operator for
# everything this bridge transmits.
DMR_ID=1234567
DMR_CALLSIGN=N0CALL

# ── Your DMR master ────────────────────────────────────────────────────────
# HBLink3, BrandMeister, or any HomeBrew-Protocol master.
# HBLink3 commonly uses 54000; BrandMeister uses 62031.
DMR_MASTER_HOST=master.example.org
DMR_MASTER_PORT=62031
DMR_MASTER_PASSWORD=change-me
DMR_COLOR_CODE=1

# Talkgroup used when the CAD sends text-to-speech without naming one.
DMR_DEFAULT_TG=0

# ── Link to TicketsCAD ─────────────────────────────────────────────────────
# Must EXACTLY match the token on the DMR channel in the CAD
# (Settings → Communications → DMR). Generate: openssl rand -hex 32
DMR_BEARER_TOKEN=

# Where the CAD-facing HTTP port is published on this host.
# Use 127.0.0.1 when the CAD runs on this same machine (safest). Use 0.0.0.0
# only if the CAD is on another host AND this port is firewalled to it.
DMR_BIND_ADDR=127.0.0.1
DMR_HTTP_PORT=18091

# ── Text-to-speech (optional; OFF by default) ──────────────────────────────
# This image deliberately ships WITHOUT Piper. Everything except /tx/text
# works without it: live receive, the browser push-to-talk path (/tx/audio and
# /tx/stream), /health and the diagnostic tone (/tx/test). Only the CAD's
# "speak this text on the radio" path — used by the TX Text button, the
# weather-radio read-out and the radio-AI responder — needs a speech engine.
#
# Voice models are 50-110 MB each, language- and voice-specific, and carry
# their own per-voice licences, so baking one in would pick a voice for
# everyone and grow the image for the majority who never use it.
#
# To enable it: mount a Piper binary and an .onnx voice into the container
# (see the commented `volumes:` block in docker-compose.yml) and set both of
# these to the paths INSIDE the container. Leave them empty and /tx/text
# returns 503 with an explanation instead of failing obscurely.
DMR_PIPER_BIN=
DMR_PIPER_VOICE=

# ── Optional station metadata (cosmetic) ───────────────────────────────────
DMR_LOCATION=TicketsCAD
DMR_DESCRIPTION=TicketsCAD DMR bridge
DMR_LATITUDE=0.0
DMR_LONGITUDE=0.0
DMR_LOG_LEVEL=INFO
