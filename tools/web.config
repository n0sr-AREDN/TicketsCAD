<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS does not read .htaccess at all, so tools/.htaccess protects nothing on a
  Windows/IIS install. This file is the IIS equivalent: deny every request that
  maps into tools/.

  tools/ holds command-line maintenance scripts — installers, schema repair,
  backup/restore, audits, token minting. Every script here also carries a
  PHP_SAPI guard; this is the server-level half of the same fence.
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="." />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <authorization>
      <deny users="*" />
    </authorization>
    <directoryBrowse enabled="false" />
  </system.webServer>
</configuration>
