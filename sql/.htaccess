# Nothing in sql/ is part of the web interface.
#
# These are command-line migration and seed scripts. sql/run_migrations.php in
# particular applies every pending database migration, and under a web SAPI
# $argv is null, so --list and --force are both false and it goes straight to
# "apply" — an unauthenticated GET /sql/run_migrations.php would migrate the
# database. On 2026-07-30 GET /sql/ returned a directory listing of all 181
# scripts on a live internet-facing install.
#
# This file is defence in depth. It duplicates the block in the root .htaccess
# on purpose, so the directory stays protected if an operator replaces or loses
# the root file — and every script here ALSO carries a PHP_SAPI guard, which is
# the only layer that survives a server that ignores .htaccess entirely.
#
# Use RedirectMatch / RewriteRule only: <Directory> and <DirectoryMatch> are
# illegal in .htaccess (Apache answers 500 for the whole site), and `Options` /
# `Require` need AllowOverride levels a host may not grant.
<IfModule mod_alias.c>
    RedirectMatch 404 (^|/)sql(/|$)
</IfModule>
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule .* - [F,L]
</IfModule>
