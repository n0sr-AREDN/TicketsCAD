# Normalize line endings — code is LF, regardless of contributor OS.
# Binaries are untouched.

* text=auto eol=lf

# Source files — LF
*.php  text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.htm  text eol=lf
*.md   text eol=lf
*.sql  text eol=lf
*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.xml  text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf
.htaccess      text eol=lf

# Windows-only — keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.bmp  binary
*.ico  binary
*.zip  binary
*.tar  binary
*.gz   binary
*.pdf  binary
*.mp3  binary
*.mp4  binary
*.webm binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.otf  binary

# SBOM signing artifacts (Phase 127).
# The detached signature covers the EXACT bytes of SBOM.cdx.json, so if git
# rewrote its line endings on checkout the signature would fail to verify on
# that platform and nowhere else — a confusing, platform-specific breakage of
# the one thing recipients are told they can check. Pin all three explicitly
# to LF rather than leaving the .sig and .pem to the text=auto heuristic.
SBOM.cdx.json            text eol=lf
SBOM.cdx.json.sig        text eol=lf
SBOM-signing-key.pub.pem text eol=lf

# GitHub linguist hints — surface PHP / JS as the languages, hide vendored docs
docs/* linguist-documentation
specs/* linguist-documentation
